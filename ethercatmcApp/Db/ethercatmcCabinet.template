record(mbbiDirect, "$(P)$(R)-StatusBits")
{
    field(DTYP, "asynUInt32Digital")
    field(DESC, "Cabinet 32 bit status")
    field(INP,  "@asynMask($(MOTOR_PORT),0 0x3FFFFFF)Cabinet")
    field(SCAN, "I/O Intr")

    alias("$(P)$(R)")
}

record(stringin, "$(P)$(R)-NamBit0") {
    field(DTYP, "asynOctetRead")
    field(DESC, "Cabinet status bit 0 name")
    field(INP,  "@asyn($(MOTOR_PORT),0)Cabinet_NamBit0")
    field(SCAN, "I/O Intr")

    alias("$(P)$(R)BitNam0")
}

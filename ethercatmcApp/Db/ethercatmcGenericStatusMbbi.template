record(mbbi, "$(P)$(R)$(Q)")
{
    field(DTYP, "asynUInt32Digital")
    field(DESC, "$(DESC)")
    field(INP,  "@asynMask($(MOTOR_PORT),$(AXIS_NO=0) 0x0FFFFFFF)$(ASYNPARAMNAME)")
    field(SCAN, "I/O Intr")
    # Values are hard-coded: One, and exactly one, bit is set
    field(ZRVL, "1")
    field(ONVL, "2")
    field(TWVL, "4")
    field(THVL, "8")
    field(FRVL, "16")
    field(FVVL, "32")
    field(SXVL, "64")
    field(SVVL, "128")
    field(EIVL, "256")
    field(NIVL, "512")
    field(TEVL, "1024")
    field(ELVL, "2048")
    field(TVVL, "4096")
    field(TTVL, "8192")
    field(FTVL, "16384")
    field(FFVL, "32768")
    # These will be filled out by the PLC
    field(ZRST, "ZRST")
    field(ONST, "ONST")
    field(TWST, "TWST")
    field(THST, "THST")
    field(FRST, "FRST")
    field(FVST, "FVST")
    field(SXST, "SXST")
    field(SVST, "SVST")
    field(EIST, "EIST")
    field(NIST, "NIST")
    field(TEST, "TEST")
    field(ELST, "ELST")
    field(TVST, "TVST")
    field(TTST, "TTST")
    field(FTST, "FTST")
    field(FFST, "FFST")
}
